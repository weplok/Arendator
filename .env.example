# Copy this file to .env only when you need to override Compose defaults.
# Never use these development values in production.
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173

POSTGRES_DB=arendator
POSTGRES_USER=arendator
POSTGRES_PASSWORD=arendator
POSTGRES_CONN_MAX_AGE=60

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

VITE_BACKEND_PROXY_URL=http://backend:8000
