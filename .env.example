# Copy this file to .env before starting Compose.
# Replace the secret key and administrator credentials. Never use development
# database credentials in production.
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_COOKIE_SECURE=false
DJANGO_SUPERUSER_EMAIL=admin@example.local
DJANGO_SUPERUSER_NAME=Администратор
DJANGO_SUPERUSER_PASSWORD=

POSTGRES_DB=arendator
POSTGRES_USER=arendator
POSTGRES_PASSWORD=arendator
POSTGRES_CONN_MAX_AGE=60

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

VITE_BACKEND_PROXY_URL=http://backend:8000
YANDEX_S3_BUCKET=
YANDEX_S3_ACCESS_KEY_ID=
YANDEX_S3_SECRET_ACCESS_KEY=
