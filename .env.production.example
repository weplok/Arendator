# Copy to .env.production on the server and set every value marked CHANGE_ME.
# Keep the resulting file outside version control and restrict it to chmod 600.
COMPOSE_PROJECT_NAME=arendator

DJANGO_SECRET_KEY=CHANGE_ME_LONG_RANDOM_VALUE
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=arend.weplok.space
DJANGO_CSRF_TRUSTED_ORIGINS=https://arend.weplok.space
DJANGO_COOKIE_SECURE=true
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false

DJANGO_SUPERUSER_EMAIL=CHANGE_ME@example.com
DJANGO_SUPERUSER_NAME=Администратор
DJANGO_SUPERUSER_PASSWORD=CHANGE_ME_STRONG_PASSWORD

POSTGRES_DB=arendator
POSTGRES_USER=arendator
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_VALUE
POSTGRES_CONN_MAX_AGE=60

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Optional public object storage for avatars and product photos.
YANDEX_S3_BUCKET=
YANDEX_S3_ACCESS_KEY_ID=
YANDEX_S3_SECRET_ACCESS_KEY=
