[Unit]
Description=Arendator production Docker Compose stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/arendator
ExecStart=/usr/bin/docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build --remove-orphans
ExecStop=/usr/bin/docker compose --env-file .env.production -f docker-compose.prod.yml down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
